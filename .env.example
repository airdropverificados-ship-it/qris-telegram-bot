# Copia este archivo a .env y rellena TUS valores. Nunca compartas el .env.
# NUNCA pongas claves reales en el código ni en capturas de pantalla.

# Token del bot de Telegram (de @BotFather)
BOT_TOKEN=

# Clave secreta de Xendit (Dashboard -> Settings -> API Keys).
# Test: empieza por xnd_development_ — Live: xnd_production_
XENDIT_API_KEY=

# Token de verificación de callbacks de Xendit
# (Dashboard -> Settings -> Callbacks, mismo valor que verifica el webhook)
XENDIT_CALLBACK_TOKEN=

# URL pública donde Xendit llamará al webhook (debe coincidir con la
# configurada en Dashboard -> Settings -> Callbacks -> "QR code paid").
# Ejemplo con túnel local: https://xxxx.ngrok-free.app/webhook/qris
WEBHOOK_URL=

# Puerto local del servidor webhook (por defecto 8080)
WEBHOOK_PORT=8080

# Límite de peticiones por minuto y por IP en el webhook (por defecto 120)
WEBHOOK_RATE_LIMIT_PER_MINUTE=120

# IPs permitidas para llamar al webhook, separadas por comas (opcional).
# Vacío = se acepta cualquier IP (el token sigue siendo obligatorio).
# Ejemplo: XENDIT_WEBHOOK_IPS=1.2.3.4,5.6.7.8
XENDIT_WEBHOOK_IPS=

# Tu id numérico de Telegram (para avisos de cada pago). Opcional.
# Lo ves con @userinfobot.
ADMIN_ID=

# Ruta de la base de datos SQLite (por defecto qrisbot.db)
DB_PATH=qrisbot.db
